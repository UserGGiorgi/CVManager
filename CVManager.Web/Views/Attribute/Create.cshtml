@model CVManager.Core.Entities.Attribute
@{
    ViewData["Title"] = "Create Attribute";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            <option value="">-- Select --</option>
            <option>Certification</option>
            <option>Domain Knowledge</option>
            <option>Personal Information</option>
            <option>Soft Skills</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DataType" class="form-label"></label>
        <select asp-for="DataType" class="form-select" asp-items="Html.GetEnumSelectList<CVManager.Core.Entities.AttributeType>()"></select>
        <span asp-validation-for="DataType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Options" class="form-label">Options (JSON for dropdown values)</label>
        <textarea asp-for="Options" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Options" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>