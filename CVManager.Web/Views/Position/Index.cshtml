@model IEnumerable<CVManager.Core.Entities.Position>
@{
    ViewData["Title"] = "Positions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Position</a>
        <button id="duplicateSelectedBtn" class="btn btn-outline-secondary" disabled>
            <i class="bi bi-copy"></i> Duplicate Selected
        </button>
        <button id="deleteSelectedBtn" class="btn btn-outline-danger" disabled>
            <i class="bi bi-trash"></i> Delete Selected
        </button>
    </div>
</div>

<!-- Search -->
<form method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" class="form-control" placeholder="Search positions..." value="@Context.Request.Query["search"]" />
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </div>
</form>

<form id="positionTableForm" method="post">
    <table class="table table-hover">
        <thead>
            <tr>
                <th><input type="checkbox" id="selectAll" /></th>
                <th>Title</th>
                <th>Company</th>
                <th>Level</th>
                <th>Access</th>
                <th>Attributes</th>
                <th>CVs</th>
                <th>Discussion</th>
                <th>Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pos in Model)
            {
                <tr>
                    <td><input type="checkbox" class="pos-checkbox" name="selectedIds" value="@pos.Id" /></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@pos.Id">@pos.Title</a>
                    </td>
                    <td>@pos.Company</td>
                    <td>@pos.Level</td>
                    <td>@pos.AccessType</td>
                    <td>@pos.PositionAttributes?.Count</td>
                    <td>@(pos.CVs?.Count ?? 0)</td>
                    <td>
                        <a asp-controller="Discussion" asp-action="Index" asp-route-positionId="@pos.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-chat-dots"></i> Discussion
                        </a>
                    </td>
                    <td>@pos.UpdatedAt.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
</form>

@section Scripts {
    <script>
        const selectAll = document.getElementById('selectAll');
        const checkboxes = document.querySelectorAll('.pos-checkbox');
        const deleteBtn = document.getElementById('deleteSelectedBtn');
        const duplicateBtn = document.getElementById('duplicateSelectedBtn');

        function updateButtons() {
            const anyChecked = document.querySelectorAll('.pos-checkbox:checked').length > 0;
            deleteBtn.disabled = !anyChecked;
            duplicateBtn.disabled = !anyChecked;
        }

        selectAll.addEventListener('change', function() {
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateButtons();
        });

        checkboxes.forEach(cb => cb.addEventListener('change', updateButtons));

        deleteBtn.addEventListener('click', function() {
            const form = document.getElementById('positionTableForm');
            form.action = '@Url.Action("DeleteMultiple", "Position")';
            form.submit();
        });

        duplicateBtn.addEventListener('click', function() {
            const form = document.getElementById('positionTableForm');
            form.action = '@Url.Action("DuplicateMultiple", "Position")';
            form.submit();
        });
    </script>
}