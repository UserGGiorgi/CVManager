@{
    ViewData["Title"] = "CV Manager";
}

<div class="row">
    <div class="col-md-8">
        <h2>Latest Positions</h2>
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No positions yet. Recruiters can create position templates.
        </div>
        <!-- We'll populate a table here later -->
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5>Popular Positions</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">No data yet.</p>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header">
                <h5>Tag Cloud</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">No tags yet.</p>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <h5>Statistics</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><i class="bi bi-file-text"></i> Total CVs: 0</li>
                    <li><i class="bi bi-people"></i> Candidates: 0</li>
                    <li><i class="bi bi-briefcase"></i> Recruiters: 0</li>
                    <li><i class="bi bi-plus-circle"></i> New CVs (24h): 0</li>
                </ul>
            </div>
        </div>
    </div>
</div>